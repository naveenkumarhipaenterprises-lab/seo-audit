# ---- Branding (safe to expose; NEXT_PUBLIC_*) ----
NEXT_PUBLIC_APP_NAME="SearchScope AI"
NEXT_PUBLIC_APP_TAGLINE="Understand Your SEO. Improve Your AI Visibility."

# ---- Access control (server only) ----
# When set, every page and API route requires HTTP Basic auth. Strongly recommended
# for any public deployment.
APP_PASSWORD=
APP_USERNAME=admin
# Reports are private to the browser that created them (owner cookie). Set to 1 only
# for a team deployment behind APP_PASSWORD where everyone should see all audits.
AUDIT_SHARED_HISTORY=

# ---- Google PageSpeed Insights (server only, optional, free) ----
# Without a key the shared keyless quota is used and is often exhausted (HTTP 429).
# Create one at https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
# Testing only: override the PageSpeed endpoint (default is Google's v5 runPagespeed).
PAGESPEED_ENDPOINT=

# ---- Google Search Console (server only, optional, free) ----
# OAuth "Web application" client from Google Cloud console with the Search Console API
# enabled. Redirect URI must be <your origin>/api/gsc/callback. See README.
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=http://localhost:3000/api/gsc/callback
# 32+ random characters; encrypts stored refresh tokens. Changing it disconnects everyone.
GSC_TOKEN_SECRET=
# Where encrypted tokens are stored (default ./.data/gsc).
GSC_TOKEN_DIR=

# ---- Browser rendering (optional) ----
# Path to a Chromium/Chrome binary for rendered + responsive checks, or set
# ENABLE_BROWSER_RENDERING=1 to use playwright-core's default lookup.
CHROMIUM_PATH=
ENABLE_BROWSER_RENDERING=
# Only if Chromium cannot use its sandbox (e.g. running as root in a container).
CHROMIUM_NO_SANDBOX=

# ---- Storage ----
# Directory for saved audits (default ./.data/audits; /tmp on Vercel, which is ephemeral).
AUDIT_DATA_DIR=
AUDIT_RETENTION_DAYS=30

# ---- Limits ----
MAX_CONCURRENT_AUDITS=3
AUDIT_RATE_LIMIT=6          # audits per IP per minute
# Full Site Audit crawl time budget in ms (default 180000). Pages and depth are set per audit.
CRAWL_TIME_BUDGET_MS=
CRAWLER_USER_AGENT=

# ---- Development only: egress through an HTTPS proxy ----
# For sandboxes whose only network route is a proxy. DNS is then resolved by the
# proxy, so pre-validation uses DNS-over-HTTPS; the proxy must also block private
# networks. Never set these in production.
OUTBOUND_HTTPS_PROXY=
OUTBOUND_PROXY_SKIP_DNS_CHECK=

# ---- Not used yet (schema prepared in supabase/migrations) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # server only, never NEXT_PUBLIC_
# ---- Not used yet: AI suggestions (paid per token when added) ----
AI_PROVIDER=
AI_API_KEY=
